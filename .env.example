# EasyEdit v2 Environment Configuration
# Copy this file to .env and fill in your actual values

# ========================================
# API KEYS (Required for AI features)
# ========================================

# Replicate Whisper - PRIMARY transcription provider (RECOMMENDED)
# Cost: ~$0.078 per hour of audio (95% cheaper than Google Cloud!)
# Model: Whisper Large V3 Turbo with speaker diarization
# Features:
#   - Speaker diarization (automatic speaker identification)
#   - Word-level timestamps (precise timing for editing)
#   - English-first with auto language detection
#   - 20-50x faster than realtime (44 seconds typical processing)
# Free tier: $5 free credits (~69 hours of audio)
# Setup Guide:
#   1. Create account at https://replicate.com
#   2. Go to https://replicate.com/account
#   3. Copy your API token
#   4. Paste it below
# Get started: https://replicate.com/thomasmol/whisper-diarization
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Google Cloud Speech-to-Text V1 - BACKUP transcription provider (optional)
# Cost: $1.62/hour ($0.18 base + $1.44 diarization)
# Use this if Replicate is unavailable or you need specific Google Cloud features
# Languages: 125+ languages including Malayalam, Hindi, Tamil, Telugu, Bengali, etc.
# Features: Enterprise-grade reliability, speaker diarization, word-level timestamps
# Free tier: 60 min/month + $300 credits for 3 months (~185 hours)
# Setup Guide:
#   1. Create GCP project: https://console.cloud.google.com/
#   2. Enable Speech-to-Text API: https://console.cloud.google.com/apis/library/speech.googleapis.com
#   3. Create service account: https://console.cloud.google.com/iam-admin/serviceaccounts
#   4. Download JSON key file
#   5. Set path to JSON file below
# Get started: https://cloud.google.com/speech-to-text
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# OpenAI API Key - For AI-powered enhancements (transcript improvement, summaries, highlights)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# SECURITY
# ========================================

# Secret key for JWT token generation (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Flask debug mode (set to False in production)
FLASK_DEBUG=True

# ========================================
# FILE PROCESSING LIMITS
# ========================================

# Maximum file size for uploads (in MB)
MAX_FILE_SIZE_MB=500

# How long to keep temporary files (in hours)
TEMP_FILE_RETENTION_HOURS=24

# Maximum audio duration to process (in hours)
MAX_AUDIO_DURATION_HOURS=6

# ========================================
# AUDIO PROCESSING SETTINGS
# ========================================

# Minimum clip length (in seconds) - shorter clips will be filtered out
MIN_CLIP_LENGTH_SECONDS=5

# Silence detection threshold (in dB) - lower is more sensitive
# Typical values: -40 (standard), -50 (sensitive), -30 (aggressive)
SILENCE_THRESHOLD_DB=-40

# Minimum gap between speaker changes (in seconds)
SPEAKER_CHANGE_THRESHOLD_SECONDS=2

# ========================================
# AUDIO CONVERSION SECURITY
# ========================================

# Maximum audio file size for format conversion (in MB)
MAX_AUDIO_CONVERSION_SIZE_MB=100

# Maximum concurrent audio conversions
MAX_CONCURRENT_AUDIO_CONVERSIONS=3

# Audio conversion timeout (in seconds)
AUDIO_CONVERSION_TIMEOUT_SECONDS=300

# Minimum free disk space required (in GB)
MIN_DISK_SPACE_GB=2.0

# ========================================
# DATABASE & REDIS
# ========================================

# Redis URL for Celery task queue and rate limiting
# Leave empty to use in-memory storage (development only)
REDIS_URL=redis://localhost:6379/0

# ========================================
# LOGGING
# ========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========================================
# NOTES
# ========================================
# - PRIMARY Transcription: Replicate Whisper (95% cheaper, excellent quality)
# - BACKUP Transcription: Google Cloud Speech-to-Text V1 (enterprise reliability)
# - Without REPLICATE_API_TOKEN: Transcription will fail (required for primary provider)
# - Without GOOGLE_APPLICATION_CREDENTIALS: Backup transcription unavailable (optional)
# - Without OPENAI_API_KEY: AI enhancements (transcript improvement, summaries) will be disabled
# - Without REDIS_URL: File-based job storage will be used (suitable for development)
# - Application will work with basic audio processing even without API keys
# - Cost comparison: Replicate $0.078/hr vs Google Cloud $1.62/hr (95% savings!)
# - Replicate FREE tier: $5 credits (~69 hours of audio)
# - Google Cloud FREE tier: 60 min/month + $300 credits for 3 months
