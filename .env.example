# EasyEdit v2 Environment Configuration
# Copy this file to .env and fill in your actual values

# ========================================
# API KEYS (Required for AI features)
# ========================================

# Transcription Provider Selection
# Options: 'soniox', 'sarvam', 'auto' (default: 'auto')
# 'auto' automatically selects Sarvam (if configured) for cost savings, falls back to Soniox
TRANSCRIPTION_PROVIDER=auto

# Sarvam AI API Key - For Malayalam/English speech-to-text (RECOMMENDED)
# Cost: Rs. 30/hour (~$0.36/hour) - 66% cheaper than Soniox
# Best for: Malayalam, English, and Indian language code-mixed speech with Indian accents
# Free credits: Rs. 1,000 (~33 hours of transcription)
# Get your API key from: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Soniox API Key - For multilingual speech-to-text (60+ languages)
# Cost: $1.02/hour
# Best for: High-accuracy multilingual transcription, non-Indian languages
# Get your API key from: https://soniox.com
SONIOX_API_KEY=your_soniox_api_key_here

# OpenAI API Key - For AI-powered enhancements (transcript improvement, summaries, highlights)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ========================================
# SECURITY
# ========================================

# Secret key for JWT token generation (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Flask debug mode (set to False in production)
FLASK_DEBUG=True

# ========================================
# FILE PROCESSING LIMITS
# ========================================

# Maximum file size for uploads (in MB)
MAX_FILE_SIZE_MB=500

# How long to keep temporary files (in hours)
TEMP_FILE_RETENTION_HOURS=24

# Maximum audio duration to process (in hours)
MAX_AUDIO_DURATION_HOURS=6

# ========================================
# AUDIO PROCESSING SETTINGS
# ========================================

# Minimum clip length (in seconds) - shorter clips will be filtered out
MIN_CLIP_LENGTH_SECONDS=5

# Silence detection threshold (in dB) - lower is more sensitive
# Typical values: -40 (standard), -50 (sensitive), -30 (aggressive)
SILENCE_THRESHOLD_DB=-40

# Minimum gap between speaker changes (in seconds)
SPEAKER_CHANGE_THRESHOLD_SECONDS=2

# ========================================
# AUDIO CONVERSION SECURITY
# ========================================

# Maximum audio file size for format conversion (in MB)
MAX_AUDIO_CONVERSION_SIZE_MB=100

# Maximum concurrent audio conversions
MAX_CONCURRENT_AUDIO_CONVERSIONS=3

# Audio conversion timeout (in seconds)
AUDIO_CONVERSION_TIMEOUT_SECONDS=300

# Minimum free disk space required (in GB)
MIN_DISK_SPACE_GB=2.0

# ========================================
# DATABASE & REDIS
# ========================================

# Redis URL for Celery task queue and rate limiting
# Leave empty to use in-memory storage (development only)
REDIS_URL=redis://localhost:6379/0

# ========================================
# LOGGING
# ========================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========================================
# NOTES
# ========================================
# - Transcription Provider: Set TRANSCRIPTION_PROVIDER to choose which API to use
#   * 'auto' (recommended): Uses Sarvam if available, falls back to Soniox
#   * 'sarvam': Always use Sarvam AI (requires SARVAM_API_KEY)
#   * 'soniox': Always use Soniox (requires SONIOX_API_KEY)
# - Cost Optimization: Sarvam is 66% cheaper than Soniox and includes Rs. 1,000 free credits
# - Without any transcription API key: Transcription and speaker diarization will be disabled
# - Without OPENAI_API_KEY: AI enhancements (transcript improvement, summaries) will be disabled
# - Without REDIS_URL: File-based job storage will be used (suitable for development)
# - Application will work with basic audio processing even without any API keys
